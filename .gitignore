# Рабочие папки эпизодов (локально, не в git)
# Исключение: ep-summary.md — передаточная записка эпизода, это финальный продукт
# и главный контекст для новых чатов. Она идёт в git на месте, без копии.
episodes/ep-*/*
!episodes/ep-*/ep-summary.md

# Медиафайлы (хранятся в D:\YouTube-Studio\)
*.mp4
*.mp3
*.wav
*.mov
*.psd
*.ai
*.png
*.jpg
*.jpeg

# Системные
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
*.iml

# Установленные скиллы (ставятся командой: npx skills add heygen-com/hyperframes)
# skills-lock.json остаётся в git — он пинит версии
.agents/
.claude/skills/
.claude/settings.local.json
